<link rel="stylesheet" href="/css/tools/table.css" />
<style>
  .badge { display: inline-block; padding: 4px 12px; border-radius: 999px; font-size: 13px; font-weight: 700; }
  .badge-level1 { background: rgba(65,121,191,0.12); color: #2a5fa0; }
  .badge-level2 { background: rgba(184,134,11,0.14); color: #916508; }

  .btn-approve { background: var(--success); color: var(--success-text); border-color: #b6e8cd; }
  .btn-reject  { background: var(--danger);  color: var(--danger-text);  border-color: #f3c5c5; }

  .reason-cell { max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .modal-spacing { display: flex; gap: 12px; justify-content: flex-end; margin-top: 20px; }
  #rejectModal .modal p { font-size: 14px; color: var(--muted); margin: 4px 0 0; }
  #rejectModal .modal textarea {
    width: 100%; height: 90px; margin-top: 12px; border: 1px solid #cdd9e8; border-radius: 10px;
    padding: 10px 14px; font-size: 14px; font-family: inherit; outline: none; resize: vertical;
  }
</style>

<section class="content">
  <div class="toolbar">
    <div class="search-box">
      <svg viewBox="0 0 24 24" fill="none">
        <path d="M21 21L16.65 16.65M10.5 18C14.6421 18 18 14.6421 18 10.5C18 6.35786 14.6421 3 10.5 3C6.35786 3 3 6.35786 3 10.5C3 14.6421 6.35786 18 10.5 18Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <input type="text" id="searchInput" placeholder="Search Employee, Project, Reason..." />
    </div>
    <select id="filterYear" class="filter-box"><option value="">All Years</option></select>
    <select id="filterMonth" class="filter-box">
      <option value="">All Months</option>
      <option value="1">January</option><option value="2">February</option><option value="3">March</option>
      <option value="4">April</option><option value="5">May</option><option value="6">June</option>
      <option value="7">July</option><option value="8">August</option><option value="9">September</option>
      <option value="10">October</option><option value="11">November</option><option value="12">December</option>
    </select>
  </div>

  <div class="card1">
    <div class="table-header">
      <h3>คิวรออนุมัติ OT</h3>
      <div class="table-count" id="queueCount">Loading...</div>
    </div>
    <div class="table-body">
      <table>
        <colgroup>
          <col style="width:16%;" /><col style="width:20%;" /><col style="width:10%;" />
          <col style="width:10%;" /><col style="width:8%;" /><col style="width:20%;" /><col style="width:16%;" />
        </colgroup>
        <thead>
          <tr><th>พนักงาน</th><th>โปรเจค</th><th>วันที่</th><th>ชั่วโมง</th><th>ขั้น</th><th>เหตุผล</th><th>การดำเนินการ</th></tr>
        </thead>
        <tbody id="tableBody">
          <tr><td colspan="7" class="loading-state">Loading...</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<div class="modal-content" id="rejectModal">
  <div class="modal">
    <h2>ไม่อนุมัติคำขอ</h2>
    <p>ยืนยันไม่อนุมัติคำขอ OT นี้ — คำขอจะถูกปิดเป็นสถานะ "ไม่อนุมัติ" และพนักงานต้องยื่นคำขอใหม่</p>
    <div class="modal-spacing">
      <button class="btn-cancel" onclick="closeRejectModal()">ยกเลิก</button>
      <button class="btn-save" style="background:#d14343;" onclick="confirmReject()">ยืนยันไม่อนุมัติ</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>

  function esc(str) { if (str == null) return ''; return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  function fmtDate(v) { return v ? String(v).slice(0, 10) : ''; }

  const LEVEL_CLS = { pending_level1: 'badge-level1', pending_level2: 'badge-level2' };
  const LEVEL_TEXT = { pending_level1: 'ขั้น 1', pending_level2: 'ขั้น 2' };

  let allRows = [];
  let rejectTargetId = null;

  async function fetchJson(url, options) {
    const res = await fetch(url, options);
    const body = await res.json().catch(() => null);
    if (!res.ok) throw new Error((body && body.message) || 'เกิดข้อผิดพลาด');
    return body;
  }

  function populateYears(rows) {
    const years = [...new Set(rows.map(r => Number(fmtDate(r.otDate).slice(0, 4))))].sort((a, b) => b - a);
    const sel = document.getElementById('filterYear');
    sel.innerHTML = '<option value="">All Years</option>' + years.map(y => `<option value="${y}">${y}</option>`).join('');
  }

  async function loadQueue() {
    try {
      allRows = await fetchJson('/ot-approval/api/queue');
    } catch (err) {
      showToast(err.message);
      allRows = [];
    }
    populateYears(allRows);
    applyFilters();
  }

  function applyFilters() {
    const q = document.getElementById('searchInput').value.trim().toLowerCase();
    const year = document.getElementById('filterYear').value;
    const month = document.getElementById('filterMonth').value;

    const filtered = allRows.filter(row => {
      const date = fmtDate(row.otDate);
      const matchSearch = !q ||
        (row.userName && row.userName.toLowerCase().includes(q)) ||
        (row.projectName && row.projectName.toLowerCase().includes(q)) ||
        (row.reason && row.reason.toLowerCase().includes(q));
      const matchYear = !year || Number(date.slice(0, 4)) === Number(year);
      const matchMonth = !month || Number(date.slice(5, 7)) === Number(month);
      return matchSearch && matchYear && matchMonth;
    });

    renderTable(filtered);
  }

  function renderTable(rows) {
    document.getElementById('queueCount').textContent = rows.length + ' รายการ';
    const tbody = document.getElementById('tableBody');

    if (rows.length === 0) { tbody.innerHTML = '<tr><td colspan="7" class="empty-state">ไม่มีรายการรออนุมัติของคุณ</td></tr>'; return; }

    tbody.innerHTML = rows.map(row => `
      <tr>
        <td>${esc(row.userName || '-')}</td>
        <td>${esc(row.projectName || '-')}</td>
        <td>${fmtDate(row.otDate)}</td>
        <td>${row.hours} ชม.</td>
        <td><span class="badge ${LEVEL_CLS[row.status]}">${LEVEL_TEXT[row.status]}</span></td>
        <td class="reason-cell" title="${esc(row.reason)}">${esc(row.reason)}</td>
        <td>
          <div class="button-spacing">
            <button class="btn-table btn-approve" onclick="approveOne(${row.id})">อนุมัติ</button>
            <button class="btn-table btn-reject" onclick="openRejectModal(${row.id})">ไม่อนุมัติ</button>
          </div>
        </td>
      </tr>`).join('');
  }

  document.getElementById('searchInput').addEventListener('input', applyFilters);
  document.getElementById('filterYear').addEventListener('change', applyFilters);
  document.getElementById('filterMonth').addEventListener('change', applyFilters);

  async function approveOne(id) {
    try {
      await fetchJson(`/ot-approval/api/requests/${id}/approve`, { method: 'POST' });
      showToast('อนุมัติเรียบร้อย ส่งต่อขั้นถัดไปแล้ว');
      loadQueue();
    } catch (err) {
      showToast(err.message);
    }
  }

  function openRejectModal(id) {
    rejectTargetId = id;
    document.getElementById('rejectModal').classList.add('open');
  }
  function closeRejectModal() { document.getElementById('rejectModal').classList.remove('open'); }
  async function confirmReject() {
    try {
      await fetchJson(`/ot-approval/api/requests/${rejectTargetId}/reject`, { method: 'POST' });
      closeRejectModal();
      showToast('ไม่อนุมัติเรียบร้อย');
      loadQueue();
    } catch (err) {
      showToast(err.message);
    }
  }

  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 3200);
  }

  loadQueue();
</script>
