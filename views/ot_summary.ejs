<link rel="stylesheet" href="/css/tools/table.css" />
<style>
  .cycle-banner {
    display: flex; align-items: center; gap: 24px; flex-wrap: wrap;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: #fff; border-radius: var(--radius); padding: 22px 28px; margin-bottom: 20px; box-shadow: var(--shadow);
  }
  .cycle-banner .cycle-item { display: flex; flex-direction: column; gap: 4px; }
  .cycle-banner .cycle-label { font-size: 12px; opacity: 0.75; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; }
  .cycle-banner .cycle-value { font-size: 20px; font-weight: 800; }
  .cycle-banner .countdown { margin-left: auto; text-align: right; }
  .cycle-banner .countdown .cycle-value { font-size: 26px; color: #ffd479; }

  .badge { display: inline-block; padding: 4px 12px; border-radius: 999px; font-size: 13px; font-weight: 700; }
  .badge-done { background: rgba(53,179,126,0.12); color: #1a7a54; }
</style>

<section class="content">
  <div class="cycle-banner" id="cycleBanner"></div>

  <div class="toolbar">
    <div class="search-box">
      <svg viewBox="0 0 24 24" fill="none">
        <path d="M21 21L16.65 16.65M10.5 18C14.6421 18 18 14.6421 18 10.5C18 6.35786 14.6421 3 10.5 3C6.35786 3 3 6.35786 3 10.5C3 14.6421 6.35786 18 10.5 18Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <input type="text" id="searchInput" placeholder="Search Employee, Team, Project..." />
    </div>
    <select id="filterYear" class="filter-box"><option value="">All Years</option></select>
    <select id="filterMonth" class="filter-box">
      <option value="">All Months</option>
      <option value="1">January</option><option value="2">February</option><option value="3">March</option>
      <option value="4">April</option><option value="5">May</option><option value="6">June</option>
      <option value="7">July</option><option value="8">August</option><option value="9">September</option>
      <option value="10">October</option><option value="11">November</option><option value="12">December</option>
    </select>
  </div>

  <div class="card1">
    <div class="table-header">
      <h3>Fully Approved OT Requests</h3>
      <div class="table-count" id="rowCount">Loading...</div>
    </div>
    <div class="table-body">
      <table>
        <colgroup>
          <col style="width:14%;" /><col style="width:12%;" /><col style="width:20%;" />
          <col style="width:10%;" /><col style="width:8%;" /><col style="width:12%;" /><col style="width:8%;" /><col style="width:12%;" />
        </colgroup>
        <thead>
          <tr><th>Employee</th><th>Team</th><th>Project</th><th>Date</th><th>Hours</th><th>Type</th><th>Cycle</th><th>Action</th></tr>
        </thead>
        <tbody id="tableBody"><tr><td colspan="8" class="loading-state">Loading...</td></tr></tbody>
      </table>
    </div>
  </div>
</section>

<script>
  // ==========================================================================
  // Connected to the real backend — data comes from /ot-summary/api/rows
  // (fully approved OT for everyone, filtered by the monthly cutoff cycle on the 20th)
  // ==========================================================================
  function esc(str) { if (str == null) return ''; return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  function fmtDate(v) { return v ? String(v).slice(0, 10) : ''; }

  const TYPE_LABEL = { weekday: 'Regular Weekday OT', holiday: 'Holiday OT' };

  let allRows = [];
  let currentCycle = null;

  async function fetchJson(url) {
    const res = await fetch(url);
    const body = await res.json().catch(() => null);
    if (!res.ok) throw new Error((body && body.message) || 'An error occurred');
    return body;
  }

  function renderCycleBanner() {
    const cutoff = new Date(currentCycle.cutoffDate + 'T23:59:00');
    const days = Math.max(0, Math.ceil((cutoff - new Date()) / (1000 * 60 * 60 * 24)));
    document.getElementById('cycleBanner').innerHTML = `
      <div class="cycle-item"><div class="cycle-label">Current Cycle</div><div class="cycle-value">${currentCycle.month}/${currentCycle.year}</div></div>
      <div class="cycle-item"><div class="cycle-label">Cutoff Date</div><div class="cycle-value">${currentCycle.cutoffDate}</div></div>
      <div class="cycle-item countdown"><div class="cycle-label">Remaining</div><div class="cycle-value">${days} days</div></div>
    `;
  }

  function populateYears(rows) {
    const years = [...new Set(rows.map(r => Number(fmtDate(r.otDate).slice(0, 4))))].sort((a, b) => b - a);
    const sel = document.getElementById('filterYear');
    sel.innerHTML = '<option value="">All Years</option>' + years.map(y => `<option value="${y}">${y}</option>`).join('');
  }

  async function loadRows() {
    const data = await fetchJson('/ot-summary/api/rows');
    currentCycle = data.cycle;
    allRows = data.rows.sort((a, b) => fmtDate(b.otDate).localeCompare(fmtDate(a.otDate)));
    renderCycleBanner();
    populateYears(allRows);
    applyFilters();
  }

  function applyFilters() {
    const q = document.getElementById('searchInput').value.trim().toLowerCase();
    const year = document.getElementById('filterYear').value;
    const month = document.getElementById('filterMonth').value;

    const filtered = allRows.filter(r => {
      const date = fmtDate(r.otDate);
      const matchSearch = !q ||
        (r.userName && r.userName.toLowerCase().includes(q)) ||
        (r.teamName && r.teamName.toLowerCase().includes(q)) ||
        (r.projectName && r.projectName.toLowerCase().includes(q));
      const matchYear = !year || Number(date.slice(0, 4)) === Number(year);
      const matchMonth = !month || Number(date.slice(5, 7)) === Number(month);
      return matchSearch && matchYear && matchMonth;
    });

    renderTable(filtered);
  }

  function renderTable(rows) {
    document.getElementById('rowCount').textContent = rows.length + ' items';
    const tbody = document.getElementById('tableBody');
    if (rows.length === 0) { tbody.innerHTML = '<tr><td colspan="8" class="empty-state">No records found</td></tr>'; return; }

    tbody.innerHTML = rows.map(r => `
        <tr>
          <td>${esc(r.userName || '-')}</td>
          <td>${esc(r.teamName || '-')}</td>
          <td>${esc(r.projectName || '-')}</td>
          <td>${fmtDate(r.otDate)}</td>
          <td>${r.hours} hrs</td>
          <td>${TYPE_LABEL[r.otType]}</td>
          <td><span class="badge badge-done">${currentCycle.month}/${currentCycle.year}</span></td>
          <td><button class="btn-table btn-detail" onclick="location.href='/ot-document?requestId=${r.id}'">View Document</button></td>
        </tr>`).join('');
  }

  document.getElementById('searchInput').addEventListener('input', applyFilters);
  document.getElementById('filterYear').addEventListener('change', applyFilters);
  document.getElementById('filterMonth').addEventListener('change', applyFilters);

  loadRows();
</script>
