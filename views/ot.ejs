<link rel="stylesheet" href="/css/tools/table.css" />
<style>
  .badge { display: inline-block; padding: 4px 12px; border-radius: 999px; font-size: 13px; font-weight: 700; }
  .badge-progress { background: rgba(65,121,191,0.12); color: #2a5fa0; }
  .badge-late     { background: rgba(220,53,69,0.12);  color: #b91c1c; }
  .badge-done     { background: rgba(53,179,126,0.12); color: #1a7a54; }

  .form-group2 { display: flex; flex-direction: column; gap: 6px; }
  .form-group2 label { font-size: 14px; font-weight: 700; color: #4a6483; }
  .form-group2 input, .form-group2 select, .form-group2 textarea {
    height: 40px; border: 1px solid #cdd9e8; border-radius: 10px; padding: 0 14px;
    font-size: 15px; color: var(--text); outline: none; transition: border 0.2s; background: #fff; font-family: inherit;
  }
  .form-group2 textarea { height: auto; padding: 10px 14px; resize: vertical; min-height: 70px; }
  .form-group2 input:focus, .form-group2 select:focus, .form-group2 textarea:focus { border-color: #4179bf; }
  .form-group1 { grid-column: span 2; }
  .hours-preview { grid-column: span 2; font-size: 13px; font-weight: 700; color: var(--accent); margin-top: -10px; }

  .trail-step { display: flex; gap: 14px; padding: 12px 0; border-bottom: 1px solid #eef3f8; }
  .trail-step:last-child { border-bottom: none; }
  .trail-dot { width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 13px; flex-shrink: 0; }
  .trail-dot.approved { background: var(--success); color: var(--success-text); }
  .trail-dot.rejected { background: var(--danger); color: var(--danger-text); }
  .trail-dot.superseded { background: #eef1f6; color: #9aa8ba; }
  .trail-dot.pending { background: var(--info); color: var(--info-text); }
  .trail-body { flex: 1; }
  .trail-title { font-weight: 700; color: var(--text); font-size: 14px; }
  .trail-meta { font-size: 13px; color: var(--muted); margin-top: 2px; }
  .trail-comment { font-size: 13px; color: var(--text); margin-top: 6px; background: #f7fafd; border-radius: 8px; padding: 8px 10px; }
</style>

<section class="content">
  <div class="toolbar">
    <div class="search-box">
      <svg viewBox="0 0 24 24" fill="none">
        <path d="M21 21L16.65 16.65M10.5 18C14.6421 18 18 14.6421 18 10.5C18 6.35786 14.6421 3 10.5 3C6.35786 3 3 6.35786 3 10.5C3 14.6421 6.35786 18 10.5 18Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <input type="text" id="searchInput" placeholder="Search Project, Reason..." />
    </div>
    <select id="filterYear" class="filter-box"><option value="">All Years</option></select>
    <select id="filterMonth" class="filter-box">
      <option value="">All Months</option>
      <option value="1">January</option><option value="2">February</option><option value="3">March</option>
      <option value="4">April</option><option value="5">May</option><option value="6">June</option>
      <option value="7">July</option><option value="8">August</option><option value="9">September</option>
      <option value="10">October</option><option value="11">November</option><option value="12">December</option>
    </select>
    <button class="add-table-box" id="addBtn"><span style="font-size:20px;line-height:1;">+</span> Submit New OT Request</button>
  </div>

  <div class="card1">
    <div class="table-header">
      <h3>OT Request History</h3>
      <div class="table-count" id="reqCount">Loading...</div>
    </div>
    <div class="table-body">
      <table>
        <colgroup>
          <col style="width: 10%;" /><col style="width: 16%;" /><col style="width: 16%;" /><col style="width: 12%;" />
          <col style="width: 9%;" /><col style="width: 12%;" /><col style="width: 11%;" /><col style="width: 14%;" />
        </colgroup>
        <thead>
          <tr><th>Date</th><th>Project</th><th>Customer</th><th>Time</th><th>Hours</th><th>Type</th><th>Status</th><th>Action</th></tr>
        </thead>
        <tbody id="tableBody"><tr><td colspan="8" class="loading-state">Loading...</td></tr></tbody>
      </table>
    </div>
  </div>
</section>

<!-- Modal: Add -->
<div class="modal-content" id="modalOverlay">
  <div class="modal">
    <h2>Submit New OT Request</h2>
    <div class="form-bar">
      <div class="form-group2">
        <label>Project</label>
        <input type="text" id="fieldProject" list="projectOptions" placeholder="Type to search project" autocomplete="off" />
        <input type="hidden" id="fieldProjectId" />
        <datalist id="projectOptions"></datalist>
      </div>
      <div class="form-group2">
        <label>Customer</label>
        <input type="text" id="fieldCustomer" placeholder="Enter customer name" />
      </div>
    </div>
    <div class="form-bar">
      <div class="form-group2">
        <label>OT Date</label>
        <input type="date" id="fieldDate" />
      </div>
      <div class="form-group2">
        <label>OT Type</label>
        <select id="fieldType">
          <option value="weekday">Regular Weekday OT</option>
          <option value="holiday">Holiday OT</option>
        </select>
      </div>
    </div>
    <div class="form-bar">
      <div class="form-group2">
        <label>Start Time</label>
        <select id="fieldStart"></select>
      </div>
      <div class="form-group2">
        <label>End Time</label>
        <select id="fieldEnd"></select>
      </div>
      <div class="hours-preview" id="hoursPreview">Total Hours: -</div>
    </div>
    <div class="form-bar">
      <div class="form-group2 form-group1">
        <label>Reason</label>
        <textarea id="fieldReason" placeholder="Enter the reason for OT"></textarea>
      </div>
    </div>
    <div class="modal-spacing">
      <button class="btn-cancel" id="cancelBtn">Cancel</button>
      <button class="btn-save" id="saveBtn">Save</button>
    </div>
  </div>
</div>

<!-- Modal: approval trail -->
<div class="modal-content" id="trailModal">
  <div class="modal">
    <h2>Approval Details</h2>
    <div id="trailBody"></div>
    <div class="modal-spacing"><button class="btn-cancel" onclick="closeTrail()">Close</button></div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
  // ==========================================================================
  // Connected to the real backend — all data comes from /ot/api/... (overtime_requests table)
  // ==========================================================================
  const STATUS_LABEL = {
    pending_level1: { label: 'Pending Level 1', cls: 'badge-progress' },
    pending_level2: { label: 'Pending Level 2', cls: 'badge-progress' },
    approved:       { label: 'Fully Approved', cls: 'badge-done' },
    rejected:       { label: 'Rejected', cls: 'badge-late' },
  };
  const TYPE_LABEL = { weekday: 'Regular Weekday OT', holiday: 'Holiday OT' };

  function esc(str) { if (str == null) return ''; return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  function computeHours(start, end) {
    const [sh, sm] = start.split(':').map(Number);
    const [eh, em] = end.split(':').map(Number);
    let minutes = (eh * 60 + em) - (sh * 60 + sm);
    if (minutes <= 0) minutes += 24 * 60;
    return Math.round((minutes / 60) * 100) / 100;
  }
  function fmtDate(v) { return v ? String(v).slice(0, 10) : ''; }

  let allRows = [];

  async function fetchJson(url, options) {
    const res = await fetch(url, options);
    const body = await res.json().catch(() => null);
    if (!res.ok) throw new Error((body && body.message) || 'An error occurred');
    return body;
  }

  let projectList = [];

  async function initProjectSelect() {
    projectList = await fetchJson('/ot/api/projects');
    document.getElementById('projectOptions').innerHTML = projectList.map(p => `<option value="${esc(p.name)}"></option>`).join('');
  }

  function syncProjectId() {
    const name = document.getElementById('fieldProject').value.trim();
    const match = projectList.find(p => p.name === name);
    document.getElementById('fieldProjectId').value = match ? match.id : '';
  }
  document.getElementById('fieldProject').addEventListener('input', syncProjectId);

  function populateHourSelect(selectEl) {
    let opts = '<option value="">--:--</option>';
    for (let h = 0; h < 24; h++) {
      const v = String(h).padStart(2, '0') + ':00';
      opts += `<option value="${v}">${v}</option>`;
    }
    selectEl.innerHTML = opts;
  }
  populateHourSelect(document.getElementById('fieldStart'));
  populateHourSelect(document.getElementById('fieldEnd'));

  function updateHoursPreview() {
    const s = document.getElementById('fieldStart').value;
    const e = document.getElementById('fieldEnd').value;
    const el = document.getElementById('hoursPreview');
    el.textContent = (s && e) ? 'Total Hours: ' + computeHours(s, e) + ' hrs' : 'Total Hours: -';
  }
  document.getElementById('fieldStart').addEventListener('change', updateHoursPreview);
  document.getElementById('fieldEnd').addEventListener('change', updateHoursPreview);

  function populateYears(rows) {
    const years = [...new Set(rows.map(r => Number(fmtDate(r.otDate).slice(0, 4))))].sort((a, b) => b - a);
    const sel = document.getElementById('filterYear');
    sel.innerHTML = '<option value="">All Years</option>' + years.map(y => `<option value="${y}">${y}</option>`).join('');
  }

  async function loadRequests() {
    allRows = (await fetchJson('/ot/api/requests')).sort((a, b) => fmtDate(b.otDate).localeCompare(fmtDate(a.otDate)));
    populateYears(allRows);
    applyFilters();
  }

  function applyFilters() {
    const q = document.getElementById('searchInput').value.trim().toLowerCase();
    const year = document.getElementById('filterYear').value;
    const month = document.getElementById('filterMonth').value;

    const filtered = allRows.filter(r => {
      const date = fmtDate(r.otDate);
      const matchSearch = !q ||
        (r.projectName && r.projectName.toLowerCase().includes(q)) ||
        (r.customerName && r.customerName.toLowerCase().includes(q)) ||
        (r.reason && r.reason.toLowerCase().includes(q));
      const matchYear = !year || Number(date.slice(0, 4)) === Number(year);
      const matchMonth = !month || Number(date.slice(5, 7)) === Number(month);
      return matchSearch && matchYear && matchMonth;
    });

    renderTable(filtered);
  }

  function renderTable(rows) {
    document.getElementById('reqCount').textContent = rows.length + ' items';

    const tbody = document.getElementById('tableBody');
    if (rows.length === 0) { tbody.innerHTML = '<tr><td colspan="8" class="empty-state">No data found</td></tr>'; return; }

    tbody.innerHTML = rows.map(r => {
      const s = STATUS_LABEL[r.status];
      const actions = [`<button class="btn-table btn-detail" onclick="openTrail(${r.id})">Details</button>`];
      return `
        <tr>
          <td>${fmtDate(r.otDate)}</td>
          <td>${esc(r.projectName || '-')}</td>
          <td>${esc(r.customerName)}</td>
          <td>${r.startTime}-${r.endTime}</td>
          <td>${r.hours} hrs</td>
          <td>${TYPE_LABEL[r.otType]}</td>
          <td><span class="badge ${s.cls}">${s.label}</span></td>
          <td><div class="button-spacing">${actions.join('')}</div></td>
        </tr>`;
    }).join('');
  }

  document.getElementById('searchInput').addEventListener('input', applyFilters);
  document.getElementById('filterYear').addEventListener('change', applyFilters);
  document.getElementById('filterMonth').addEventListener('change', applyFilters);

  // No separate approvals table in the real database — the step sequence is derived from
  // approval_status + the request's own supervisor_approved_at / manager_approved_at
  function buildTrail(req) {
    const steps = [];

    if (req.supervisorApprovedAt) {
      steps.push({ level: 1, state: 'approved', decidedAt: req.supervisorApprovedAt, label: 'Approved (Manager)' });
    } else if (req.status === 'rejected') {
      steps.push({ level: 1, state: 'rejected', decidedAt: null, label: 'Rejected (Supervisor)' });
    } else {
      steps.push({ level: 1, state: 'pending', decidedAt: null, label: 'Pending (Supervisor)' });
    }

    if (req.managerApprovedAt) {
      steps.push({ level: 2, state: 'approved', decidedAt: req.managerApprovedAt, label: 'Approved (HeadTeam)' });
    } else if (req.status === 'rejected' && req.supervisorApprovedAt) {
      steps.push({ level: 2, state: 'rejected', decidedAt: null, label: 'Rejected (Manager)' });
    } else if (req.status === 'pending_level2') {
      steps.push({ level: 2, state: 'pending', decidedAt: null, label: 'Pending (Manager)' });
    } else {
      steps.push({ level: 2, state: 'superseded', decidedAt: null, label: 'Not reached yet' });
    }

    return steps;
  }

  function openTrail(requestId) {
    const req = allRows.find(r => r.id === requestId);
    if (!req) return;
    const html = buildTrail(req).map(s => `
        <div class="trail-step">
          <div class="trail-dot ${s.state}">${s.level}</div>
          <div class="trail-body">
            <div class="trail-title">Step ${s.level} — ${esc(s.label)}</div>
            <div class="trail-meta">${s.decidedAt ? 'Decided at ' + String(s.decidedAt).replace('T', ' ').slice(0, 19) : 'Not yet processed'}</div>
          </div>
        </div>`).join('');
    document.getElementById('trailBody').innerHTML = `<div style="margin-bottom:12px;font-size:14px;color:var(--muted);">Request date ${fmtDate(req.otDate)} — Reason: ${esc(req.reason)}</div>` + html;
    document.getElementById('trailModal').classList.add('open');
  }
  function closeTrail() { document.getElementById('trailModal').classList.remove('open'); }

  const overlay = document.getElementById('modalOverlay');

  function openAdd() {
    clearFields();
    overlay.classList.add('open');
  }

  function clearFields() {
    ['fieldProject','fieldProjectId','fieldCustomer','fieldDate','fieldStart','fieldEnd','fieldReason'].forEach(id => document.getElementById(id).value = '');
    document.getElementById('fieldType').value = 'weekday';
    updateHoursPreview();
  }

  document.getElementById('cancelBtn').addEventListener('click', () => overlay.classList.remove('open'));
  overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.classList.remove('open'); });
  document.getElementById('addBtn').addEventListener('click', openAdd);

  document.getElementById('saveBtn').addEventListener('click', async () => {
    syncProjectId();
    const projectId = Number(document.getElementById('fieldProjectId').value);
    const customerName = document.getElementById('fieldCustomer').value.trim();
    const otDate = document.getElementById('fieldDate').value;
    const startTime = document.getElementById('fieldStart').value;
    const endTime = document.getElementById('fieldEnd').value;
    const otType = document.getElementById('fieldType').value;
    const reason = document.getElementById('fieldReason').value.trim();
    if (!projectId || !customerName || !otDate || !otType || !startTime || !endTime || !reason) { showToast('Please select a valid project and fill in all fields'); return; }

    // Hours are always calculated by the backend from start/end time, initial status is pending_level1,
    // and supervisor_approved_at / manager_approved_at are set from the /ot-approval page when an approver approves
    try {
      await fetchJson('/ot/api/requests', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ project_id: projectId, customer_name: customerName, ot_date: otDate, start_time: startTime, end_time: endTime, ot_type: otType, reason }),
      });
      showToast('OT request submitted successfully. Sent to the Level 1 approver.');
      overlay.classList.remove('open');
      loadRequests();
    } catch (err) {
      showToast(err.message);
    }
  });

  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 3200);
  }

  initProjectSelect();
  loadRequests();
</script>
