<link rel="stylesheet" href="/css/tools/table.css" />
<style>
  #modalOverlay .modal {
    width: 640px;
    max-height: 90vh;
    overflow-y: auto;
  }

  .project-name-link {
    color: var(--primary);
    text-decoration: none;
    transition: color 0.2s;
  }
  .project-name-link:hover { color: var(--accent); }

  .type-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .type-badge {
    background: var(--info);
    color: var(--info-text);
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 8px;
    font-weight: 600;
    white-space: nowrap;
  }

  .type-checkbox-group {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px 12px;
    border: 1px solid #cdd9e8;
    border-radius: 10px;
    padding: 12px 14px;
    background: #fff;
  }
  .type-checkbox-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    color: var(--text);
    cursor: pointer;
  }
  .po-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .po-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }
  .po-row input {
    height: 40px;
    border: 1px solid #cdd9e8;
    border-radius: 10px;
    padding: 0 14px;
    font-size: 15px;
    color: var(--text);
    outline: none;
    transition: border 0.2s;
    background: #fff;
    box-sizing: border-box;
    flex: 1 1 100px;
    min-width: 0;
  }
  .po-row input.po-created-at {
    flex: 1 1 130px;
  }
  .po-row input:focus { border-color: #4179bf; }
  .btn-remove-po {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1.5px solid rgba(220,53,69,0.35);
    background: rgba(220,53,69,0.1);
    color: #b91c1c;
    cursor: pointer;
    font-size: 16px;
    line-height: 1;
  }
  .btn-remove-po:hover { background: rgba(220,53,69,0.2); }
  .btn-add-po {
    align-self: flex-start;
    border: 1.5px dashed #4179bf;
    background: transparent;
    color: #4179bf;
    border-radius: 10px;
    padding: 8px 14px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .btn-add-po:hover { background: rgba(65,121,191,0.08); }

  .type-checkbox-item input[type="checkbox"] {
    width: 15px;
    height: 15px;
    cursor: pointer;
    accent-color: #4179bf;
    flex-shrink: 0;
  }

  /* Lock toolbar — only table body scrolls */
  .main { overflow: hidden; height: 100vh; }
  .content {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-height: 0;
  }
  .toolbar { flex-shrink: 0; }
  .card1 {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-height: 0;
  }
  .table-body {
    flex: 1;
    overflow-y: auto;
    min-height: 0;
  }
  thead th {
    position: sticky;
    top: 0;
    z-index: 1;
  }

  .badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
  }
  .badge-progress { background: rgba(65,121,191,0.12); color: #2a5fa0; }
  .badge-late     { background: rgba(220,53,69,0.12);  color: #b91c1c; }
  .badge-done     { background: rgba(53,179,126,0.12); color: #1a7a54; }

  .btn-complete {
    background: rgba(53,179,126,0.13);
    color: #1a7a54;
    border: 1.5px solid rgba(53,179,126,0.35);
  }
  .btn-complete:hover { background: rgba(53,179,126,0.22); }
</style>

<section class="content">
  <div class="toolbar">
    <div class="search-box">
      <svg viewBox="0 0 24 24" fill="none">
        <path
          d="M21 21L16.65 16.65M10.5 18C14.6421 18 18 14.6421 18 10.5C18 6.35786 14.6421 3 10.5 3C6.35786 3 3 6.35786 3 10.5C3 14.6421 6.35786 18 10.5 18Z"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <input type="text" id="searchInput" placeholder="Search Item, Project Name, Sales Name..." />
    </div>

    <select id="filterYear" class="filter-box">
      <option value="">All Years</option>
    </select>

    <select id="filterStatus" class="filter-box">
      <option value="">All Months</option>
      <option value="1">January</option>
      <option value="2">February</option>
      <option value="3">March</option>
      <option value="4">April</option>
      <option value="5">May</option>
      <option value="6">June</option>
      <option value="7">July</option>
      <option value="8">August</option>
      <option value="9">September</option>
      <option value="10">October</option>
      <option value="11">November</option>
      <option value="12">December</option>
    </select>

    <select id="filterProjectStatus" class="filter-box">
      <option value="">All Status</option>
      <option value="in_progress">In Progress</option>
      <option value="delayed">Delayed</option>
      <option value="completed">Completed</option>
    </select>

    <button class="add-table-box" id="addBtn">
      <span style="font-size:20px;line-height:1;">+</span>
      Add New Item
    </button>
  </div>

  <!-- Table -->
  <div class="card1">
    <div class="table-header">
      <h3>Incoming Project List</h3>
      <div class="table-count" id="projectCount">Loading...</div>
    </div>
    <div class="table-body">
      <table>
        <colgroup>
          <col style="width: 12%;" />
          <col style="width: 10%;" />
          <col style="width: 10%;" />
          <col style="width: 10%;" />
          <col style="width: 10%;" />
          <col style="width: 10%;" />
          <col style="width: 18%;" />
        </colgroup>
        <thead>
          <tr>
            <th>Project Name</th>
            <th>Type</th>
            <th>Sales Name</th>
            <th>PO Total</th>
            <th>PO Count</th>
            <th>Status</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody id="tableBody">
          <tr>
            <td colspan="7" class="loading-state">Loading data...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- Modal Add/Edit -->
<div class="modal-content" id="modalOverlay">
  <div class="modal">
    <h2 id="modalTitle">Add New Item</h2>
    <input type="hidden" id="editId" />
    <div class="form-bar" id="itemGroup">
      <div class="form-group2">
        <label>Item</label>
        <input type="text" id="fieldItem" placeholder="Enter Item No." />
      </div>
    </div>
    <div class="form-bar">
      <div class="form-group2 form-group1">
        <label>Project Name</label>
        <input type="text" id="fieldProjectName" placeholder="Enter project name" />
      </div>
    </div>
    <div class="form-bar">
      <div class="form-group2 form-group1">
        <label>Type</label>
        <div class="type-checkbox-group">
          <label class="type-checkbox-item"><input type="checkbox" name="projectType" value="1" /> BMS</label>
          <label class="type-checkbox-item"><input type="checkbox" name="projectType" value="2" /> EPO</label>
          <label class="type-checkbox-item"><input type="checkbox" name="projectType" value="3" /> PME</label>
          <label class="type-checkbox-item"><input type="checkbox" name="projectType" value="4" /> CCTV</label>
          <label class="type-checkbox-item"><input type="checkbox" name="projectType" value="5" /> ACS</label>
          <label class="type-checkbox-item"><input type="checkbox" name="projectType" value="6" /> Installation</label>
          <label class="type-checkbox-item"><input type="checkbox" name="projectType" value="7" /> Engineer</label>
          <label class="type-checkbox-item"><input type="checkbox" name="projectType" value="8" /> PM</label>
        </div>
      </div>
    </div>
    <div class="form-bar">
      <div class="form-group2 form-group1">
        <label>Sales Name</label>
        <input type="text" id="fieldSalesName" placeholder="Enter sales name" />
      </div>
    </div>
    <div class="form-bar" id="createdDateGroup">
      <div class="form-group2">
        <label>Created Date</label>
        <input type="date" id="fieldCreatedAt" lang="en" />
      </div>
    </div>
    <div class="form-bar">
      <div class="form-group2 form-group1">
        <label>PO (Purchase Orders)</label>
        <div class="po-list" id="poList"></div>
        <button type="button" class="btn-add-po" id="addPoBtn">+ Add PO</button>
      </div>
    </div>
    <div class="modal-spacing">
      <button class="btn-cancel" id="cancelBtn">Cancel</button>
      <button class="btn-save" id="saveBtn">Save</button>
    </div>
  </div>
</div>

<!-- Toast -->
<div class="toast" id="toast"></div>

<script>
  const BASE = '/incoming-project/api/projects';
  let allRows = [];

  const TYPE_NAMES = {
    1: 'BMS',
    2: 'EPO',
    3: 'CCTV',
    4: 'ACS',
    5: 'Installation',
    6: 'Engineer',
    7: 'PME',
    8: 'PM',
  };

  async function loadProjects() {
    try {
      const res = await fetch(BASE);
      const data = await res.json();
      if (!res.ok) throw new Error(data.message || `HTTP ${res.status}`);
      if (!Array.isArray(data)) throw new Error('Invalid response: ' + JSON.stringify(data).slice(0, 100));
      allRows = data;
      populateYears(data);
      applyFilters();
    } catch (err) {
      document.getElementById('tableBody').innerHTML =
        '<tr><td colspan="7" class="empty-state" style="text-align:center">Failed to load data: ' + err.message + '</td></tr>';
    }
  }

  function populateYears(rows) {
    const years = [...new Set(rows
      .filter(r => r.created_at)
      .map(r => new Date(r.created_at).getFullYear())
    )].sort((a, b) => b - a);

    const sel = document.getElementById('filterYear');
    sel.innerHTML = '<option value="">All Years</option>';
    years.forEach(y => {
      const opt = document.createElement('option');
      opt.value = y;
      opt.textContent = y;
      sel.appendChild(opt);
    });
    const urlYear = new URLSearchParams(location.search).get('year');
    if (urlYear) sel.value = urlYear;
  }

  function renderTypeBadges(types) {
    if (!types || types.length === 0) return '';
    return '<div class="type-badges">' +
      types.map((t) => `<span class="type-badge">${esc(t.name || TYPE_NAMES[t.id] || '')}</span>`).join('') +
      '</div>';
  }

  function fmtValue(val) {
    if (val == null || val === '') return '—';
    const n = Number(val);
    if (isNaN(n)) return val;
    if (n >= 1_000_000) {
      const v = n / 1_000_000;
      return (v % 1 === 0 ? v.toFixed(0) : v.toFixed(2).replace(/0+$/, '').replace(/\.$/, '')) + 'M';
    }
    if (n >= 1_000) {
      const v = n / 1_000;
      return (v % 1 === 0 ? v.toFixed(0) : v.toFixed(1).replace(/0+$/, '').replace(/\.$/, '')) + 'K';
    }
    return n.toLocaleString();
  }

  const STATUS_MAP = {
    in_progress: { label: 'In Progress', cls: 'badge-progress' },
    delayed:     { label: 'Delayed',     cls: 'badge-late'     },
    completed:   { label: 'Completed',   cls: 'badge-done'     },
  };

  function renderTable(rows) {
    const tbody = document.getElementById('tableBody');
    const count = document.getElementById('projectCount');
    count.textContent = rows.length + ' item(s)';

    if (rows.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" class="empty-state">No data found</td></tr>';
      return;
    }

    tbody.innerHTML = rows.map((row) => {
      const s = STATUS_MAP[row.status] || { label: row.status || '—', cls: '' };
      return `
        <tr>
          <td><a href="/detail-project/${row.id}" class="project-name-link"><strong>${esc(row.project_name)}</strong></a></td>
          <td>${renderTypeBadges(row.types)}</td>
          <td>${esc(row.sales_name)}</td>
          <td>${fmtValue(row.po_total)}</td>
          <td>${row.po_count || 0} PO</td>
          <td><span class="badge ${s.cls}">${s.label}</span></td>
          <td>
            <div class="button-spacing">
              ${row.status !== 'completed' ? `<button class="btn-table btn-complete" onclick="completeRow(${row.id})">Complete</button>` : ''}
              <button class="btn-table btn-edit" onclick="openEdit(${row.id})">Edit</button>
              <button class="btn-table btn-destroy" onclick="deleteRow(${row.id})">Delete</button>
            </div>
          </td>
        </tr>
      `;
    }).join('');
  }

  function esc(str) {
    if (str == null) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  document.getElementById('searchInput').addEventListener('input', applyFilters);
  document.getElementById('filterYear').addEventListener('change', applyFilters);
  document.getElementById('filterStatus').addEventListener('change', applyFilters);
  document.getElementById('filterProjectStatus').addEventListener('change', applyFilters);

  function applyFilters() {
    const q      = document.getElementById('searchInput').value.trim().toLowerCase();
    const year   = document.getElementById('filterYear').value;
    const month  = document.getElementById('filterStatus').value;
    const status = document.getElementById('filterProjectStatus').value;

    const filtered = allRows.filter((r) => {
      const matchSearch = !q ||
        String(r.item || '').toLowerCase().includes(q) ||
        (r.project_name || '').toLowerCase().includes(q) ||
        (r.sales_name || '').toLowerCase().includes(q);

      const matchYear  = !year  ||
        (r.created_at && new Date(r.created_at).getFullYear() === Number(year));

      const matchMonth = !month ||
        (r.created_at && new Date(r.created_at).getMonth() + 1 === Number(month));

      const matchStatus = !status || r.status === status;

      return matchSearch && matchYear && matchMonth && matchStatus;
    });

    renderTable(filtered);
    syncURL({ q, year, month, status });
  }

  function syncURL(filters) {
    const p = new URLSearchParams();
    if (filters.q)      p.set('q',      filters.q);
    if (filters.year)   p.set('year',   filters.year);
    if (filters.month)  p.set('month',  filters.month);
    if (filters.status) p.set('status', filters.status);
    history.replaceState(null, '', p.toString() ? '?' + p.toString() : location.pathname);
  }

  const overlay = document.getElementById('modalOverlay');
  const poList = document.getElementById('poList');

  function addPoRow(po) {
    po = po || {};
    const createdVal = po.created_at ? new Date(po.created_at).toLocaleDateString('en-CA') : '';
    const row = document.createElement('div');
    row.className = 'po-row';
    row.dataset.poId = po.id || '';
    row.innerHTML = `
      <input type="text" class="po-no" placeholder="PO No." value="${esc(po.po_no || '')}" />
      <input type="text" class="po-value" placeholder="PO Value" value="${po.po_value != null ? po.po_value : ''}" />
      <input type="date" class="po-created-at" lang="en" value="${createdVal}" />
      <button type="button" class="btn-remove-po" onclick="this.closest('.po-row').remove()">×</button>
    `;
    poList.appendChild(row);
  }

  function collectPos() {
    return Array.from(poList.querySelectorAll('.po-row')).map((row) => {
      const po_no = row.querySelector('.po-no').value.trim();
      const po_value = row.querySelector('.po-value').value.trim();
      const created_at = row.querySelector('.po-created-at').value;
      const id = row.dataset.poId ? Number(row.dataset.poId) : undefined;
      return {
        ...(id ? { id } : {}),
        po_no,
        po_value: po_value ? Number(po_value) : null,
        ...(created_at ? { created_at } : {}),
      };
    }).filter((po) => po.po_no || po.po_value);
  }

  document.getElementById('addPoBtn').addEventListener('click', () => addPoRow());

  function openAdd() {
    document.getElementById('modalTitle').textContent = 'Add New Item';
    document.getElementById('editId').value = '';
    clearFields();
    document.getElementById('fieldCreatedAt').value = new Date().toISOString().split('T')[0];
    document.getElementById('itemGroup').style.display = 'none';
    addPoRow();
    overlay.classList.add('open');
  }

  function openEdit(id) {
    const row = allRows.find((r) => r.id === id);
    if (!row) return;
    document.getElementById('modalTitle').textContent = 'Edit Item';
    document.getElementById('itemGroup').style.display = '';
    document.getElementById('editId').value = id;
    document.getElementById('fieldItem').value = row.item || '';
    document.getElementById('fieldProjectName').value = row.project_name || '';
    document.getElementById('fieldSalesName').value = row.sales_name || '';

    const createdVal = row.created_at ? new Date(row.created_at).toLocaleDateString('en-CA') : '';
    document.getElementById('fieldCreatedAt').value = createdVal;

    poList.innerHTML = '';
    (row.pos && row.pos.length ? row.pos : [{}]).forEach((po) => addPoRow(po));

    const checkedIds = (row.types || []).map((t) => String(t.id));
    document.querySelectorAll('input[name="projectType"]').forEach((cb) => {
      cb.checked = checkedIds.includes(cb.value);
    });

    overlay.classList.add('open');
  }

  function clearFields() {
    ['fieldItem', 'fieldProjectName', 'fieldSalesName', 'fieldCreatedAt']
      .forEach((id) => { document.getElementById(id).value = ''; });
    document.querySelectorAll('input[name="projectType"]').forEach((cb) => { cb.checked = false; });
    poList.innerHTML = '';
  }

  document.getElementById('cancelBtn').addEventListener('click', () => overlay.classList.remove('open'));
  overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.classList.remove('open'); });

  document.getElementById('saveBtn').addEventListener('click', async () => {
    const id = document.getElementById('editId').value;
    const typeIds = Array.from(document.querySelectorAll('input[name="projectType"]:checked'))
      .map((cb) => Number(cb.value));

    const dto = {
      item: document.getElementById('fieldItem').value.trim(),
      project_name: document.getElementById('fieldProjectName').value.trim(),
      sales_name: document.getElementById('fieldSalesName').value.trim(),
      type_ids: typeIds,
      pos: collectPos(),
    };
    if (document.getElementById('fieldCreatedAt').value) {
      dto.created_at = document.getElementById('fieldCreatedAt').value;
    }

    try {
      let res;
      if (id) {
        res = await fetch(`${BASE}/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(dto),
        });
      } else {
        res = await fetch(BASE, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(dto),
        });
      }
      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        throw new Error(err.message || `HTTP ${res.status}`);
      }
      showToast(id ? 'Item updated successfully' : 'Item added successfully');
      overlay.classList.remove('open');
      await loadProjects();
    } catch (err) {
      showToast('Error: ' + err.message);
    }
  });

  async function deleteRow(id) {
    const row = allRows.find((r) => r.id === id);
    const name = row ? row.project_name || row.item : id;
    if (!confirm(`Are you sure you want to delete "${name}"?`)) return;
    try {
      await fetch(`${BASE}/${id}`, { method: 'DELETE' });
      showToast('Item deleted successfully');
      await loadProjects();
    } catch (err) {
      showToast('Error: ' + err.message);
    }
  }

  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 2800);
  }

  async function completeRow(id) {
    if (!confirm('Mark this project as completed?')) return;
    try {
      const res = await fetch(`${BASE}/${id}/complete`, { method: 'PUT' });
      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        throw new Error(err.message || `HTTP ${res.status}`);
      }
      showToast('Project marked as completed');
      await loadProjects();
    } catch (err) {
      showToast('Error: ' + err.message);
    }
  }

  document.getElementById('addBtn').addEventListener('click', openAdd);

  // restore search & month from URL before load (year restored inside populateYears)
  (function() {
    const p = new URLSearchParams(location.search);
    if (p.get('q'))      document.getElementById('searchInput').value = p.get('q');
    if (p.get('month'))  document.getElementById('filterStatus').value = p.get('month');
    if (p.get('status')) document.getElementById('filterProjectStatus').value = p.get('status');
  })();

  loadProjects();
</script>
