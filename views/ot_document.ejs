<style>
  .back-link { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-size: 14px; font-weight: 600; text-decoration: none; margin-bottom: 16px; }
  .back-link:hover { color: var(--primary); }

  .card { background: var(--card); border-radius: var(--radius); box-shadow: var(--shadow); overflow: hidden; max-width: 720px; margin: 0 auto; }
  .card-header { display: flex; align-items: center; justify-content: space-between; padding: 18px 22px 16px; border-bottom: 1px solid #edf2f7; gap: 10px; flex-wrap: wrap; }
  .card-title { display: flex; align-items: center; gap: 9px; font-size: 15px; font-weight: 700; color: var(--primary); }
  .card-body { padding: 8px 22px 20px; }

  .doc-list { display: flex; flex-direction: column; }
  .doc-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 14px 0; border-bottom: 1px solid #f0f4f9; }
  .doc-row:last-child { border-bottom: none; }
  .doc-name { display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; color: var(--text); }
  .doc-name svg { color: var(--accent); flex-shrink: 0; }

  .btn-download {
    display: flex; align-items: center; gap: 6px;
    padding: 8px 16px; border-radius: 10px; border: none;
    background: #e8f3ff; color: #1d5fa8; font-size: 13px; font-weight: 700;
    cursor: pointer; transition: 0.18s;
  }
  .btn-download:hover { background: #cce3ff; }
</style>

<section class="content">
  <a href="/ot-summary" class="back-link">&larr; Back to OT Summary</a>

  <div class="card">
    <div class="card-header">
      <div class="card-title">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        OT Document
      </div>
    </div>
    <div class="card-body">
      <div class="doc-list" id="docList"><div class="loading-state">Loading...</div></div>
    </div>
  </div>
</section>

<script>
  function esc(str) { if (str == null) return ''; return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

  const requestId = Number(new URLSearchParams(location.search).get('requestId')) || 0;
  const list = document.getElementById('docList');

  list.innerHTML = `
      <div class="doc-row">
        <div class="doc-name">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          Overtime Approval Request Form
        </div>
        <a class="btn-download" href="/ot-document/${requestId}/download">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Download
        </a>
      </div>`;
</script>
