<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<link rel="stylesheet" href="/css/tools/table.css" />
<style>
  .main { overflow: hidden; height: 100vh; }
  .content {
    flex: 1;
    overflow-y: auto;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .workload-chart-card {
    background: var(--card-bg, #fff);
    border-radius: 14px;
    box-shadow: 0 1px 6px rgba(0,0,0,0.08);
    padding: 22px 26px;
  }

  .workload-legend {
    display: flex;
    gap: 18px;
    margin-bottom: 18px;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted, #56718f);
  }
  .workload-legend span { display: flex; align-items: center; gap: 6px; }
  .workload-legend i { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }

  .workload-chart-wrap { position: relative; }
</style>

<section class="content">
  <div class="workload-chart-card">
    <div class="workload-legend">
      <span><i style="background:#1a7a54"></i>≤50%</span>
      <span><i style="background:#d4a000"></i>51–80%</span>
      <span><i style="background:#f97316"></i>81–100%</span>
      <span><i style="background:#dc2626"></i>&gt;100%</span>
    </div>
    <div class="workload-chart-wrap" style="height:<%= Math.max(320, users.length * 44) %>px;">
      <canvas id="workloadChart"></canvas>
    </div>
  </div>
</section>

<script>
  const _users = <%- JSON.stringify(users) %>;
  const STATUS_COLOR = { green: '#1a7a54', yellow: '#d4a000', orange: '#f97316', red: '#dc2626' };

  const workloadCtx = document.getElementById('workloadChart').getContext('2d');
  const workloadChart = new Chart(workloadCtx, {
    type: 'bar',
    data: {
      labels: _users.map(u => u.name),
      datasets: [{
        label: 'Load',
        data: _users.map(u => u.pct),
        backgroundColor: _users.map(u => STATUS_COLOR[u.color] + '38'),
        borderColor: _users.map(u => STATUS_COLOR[u.color]),
        borderWidth: 1.5,
        borderRadius: 5,
        barThickness: 22,
      }]
    },
    options: {
      indexAxis: 'y',
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: '#1E3A5F', titleColor: '#fff', bodyColor: 'rgba(255,255,255,0.78)',
          padding: 12, cornerRadius: 10, boxPadding: 5,
          callbacks: {
            label: ctx => {
              const u = _users[ctx.dataIndex];
              return [` Load: ${u.pct}%`, ` Active: ${u.active} tasks`, ` In Progress: ${u.in_progress}`, ` Problem: ${u.problem}`];
            }
          }
        }
      },
      scales: {
        x: {
          beginAtZero: true,
          grid: { color: 'rgba(217,226,236,0.5)' },
          ticks: { color: '#56718f', font: { size: 12 }, callback: v => v + '%' }
        },
        y: {
          grid: { display: false },
          ticks: { color: '#1e2a3a', font: { size: 12, weight: '600' } }
        }
      },
      onClick: (evt, elements) => {
        if (!elements.length) return;
        const u = _users[elements[0].index];
        window.location.href = `/workload/${u.id}`;
      },
      onHover: (evt, elements) => {
        evt.native.target.style.cursor = elements.length ? 'pointer' : 'default';
      }
    }
  });
</script>
